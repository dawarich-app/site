    "es": "informal 'tú' (app es.yml uses tu)",
    "fr": "formal 'vous' (app fr.yml uses votre/vous)",
    "pl": "informal second person with capitalised 'Ty/Twój' in direct address (app pl.yml)",
    "ca": "informal 'tu' (app ca.yml uses teu)",
    "zh": "Simplified Chinese, polite '您' (app zh.yml)",
    "pt-br": "Brazilian Portuguese, 'você'"
  },
  "rules": [
    "Keep {placeholders} exactly as written, including braces.",
    "Keep **bold** and [link text](url) markup; translate the visible text, never the url.",
    "Keep terms from doNotTranslate verbatim.",
    "Use preferred terms below for product concepts.",
    "Prices, currencies, numbers and file names stay as they are.",
    "Meta titles stay short (aim for 60 characters or fewer), meta descriptions 160 characters or fewer.",
    "Plural messages use '|' between forms in the order Intl.PluralRules gives for the locale.",
    "Search terms: where the English names Google Timeline in a meta title, meta description, H1 or intro, also use the name Google Maps shows in that language (searchTerms below) once, next to 'Google Timeline'. People search for both. Never stuff it into every sentence."
  ],
